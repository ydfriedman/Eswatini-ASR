/**
 * @OnlyCurrentDoc
 * Clinician review of the Eswatini guideline-chat benchmark, served as a Google Apps Script web app.
 *
 * Bound to the Google Sheet that holds everything: the review page itself (tab whose A1 is PAGE_MARKER, split across
 * cells) and the answers (tab "responses": one row per reviewer per question; saving a question again updates
 * its row). @OnlyCurrentDoc limits the script to this one spreadsheet.
 *
 * Setup: Extensions > Apps Script, paste this file as Code.gs, then
 *   Project Settings > Script properties: REVIEW_ACCESS_CODE = the code you give reviewers (optional but advised)
 *   Deploy > New deployment > Web app; Execute as: Me; Who has access: Anyone.
 * Generated by benchmark_review/build_review_html.py; edit the template there, not this copy.
 */
const PAGE_MARKER = 'REVIEW_PAGE_V1 (generated - do not edit this tab)';
const SHEET_NAME = 'responses';
const COLS = ['reviewer', 'question_id', 'question_decision', 'reference_decision', 'reference_edit',
  'question_suggestion', 'must_include', 'must_not_include', 'comments', 'reviewed_at', 'saved_at', 'reviewer_key'];
const QIDS = ["Q001", "Q002", "Q003", "Q005", "Q007", "Q008", "Q009", "Q010", "Q011", "Q019", "Q020", "Q023", "Q024", "Q084", "Q085", "Q086", "Q087", "Q088", "Q089", "Q090", "Q091", "Q100", "Q101", "Q118", "Q120", "Q129", "Q132", "Q137", "Q173", "Q004", "Q037", "Q038", "Q039", "Q040", "Q041", "Q042", "Q043", "Q044", "Q045", "Q046", "Q047", "Q048", "Q081", "Q082", "Q083", "Q102", "Q116", "Q121", "Q124", "Q127", "Q130", "Q136", "Q140", "Q144", "Q145", "Q149", "Q006", "Q069", "Q070", "Q071", "Q072", "Q073", "Q074", "Q075", "Q076", "Q077", "Q078", "Q079", "Q080", "Q104", "Q117", "Q123", "Q125", "Q133", "Q135", "Q148", "Q174", "Q178", "Q058", "Q059", "Q060", "Q061", "Q062", "Q063", "Q064", "Q065", "Q066", "Q067", "Q068", "Q126", "Q152", "Q176", "Q012", "Q013", "Q014", "Q015", "Q016", "Q017", "Q018", "Q103", "Q122", "Q146", "Q172", "Q026", "Q027", "Q028", "Q029", "Q030", "Q031", "Q032", "Q033", "Q034", "Q035", "Q036", "Q134", "Q021", "Q022", "Q025", "Q092", "Q093", "Q094", "Q095", "Q096", "Q097", "Q098", "Q128", "Q131", "Q139", "Q141", "Q150", "Q153", "Q154", "Q155", "Q156", "Q157", "Q158", "Q159", "Q160", "Q161", "Q162", "Q163", "Q164", "Q165", "Q166", "Q167", "Q168", "Q169", "Q171", "Q175", "Q177", "Q170", "Q179", "Q180", "Q181", "Q182", "Q183", "Q184", "Q185", "Q186", "Q187", "Q188", "Q049", "Q050", "Q051", "Q052", "Q053", "Q054", "Q055", "Q056", "Q057", "Q099", "Q105", "Q138", "Q142", "Q106", "Q107", "Q108", "Q109", "Q110", "Q111", "Q112", "Q113", "Q114", "Q115", "Q119", "Q143", "Q147", "Q151"];
const QSET = new Set(QIDS);
const DECISIONS = {question_decision: ['', 'keep', 'rewrite'], reference_decision: ['', 'approve', 'edit', 'reject']};
const LIMITS = {question_suggestion: 3000, reference_edit: 8000, comments: 8000, reviewed_at: 40};
const MAX_ITEMS = 40, MAX_ITEM_LEN = 1000;

function doGet() {
  return HtmlService.createHtmlOutput(pageHtml_())
    .setTitle('Guideline answer review')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

/** The page is stored as cells A2:A<n> of the page tab, each wrapped in "|...|" so the import keeps edge spaces. */
function pageHtml_() {
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheets().find(s => String(s.getRange('A1').getValue()).indexOf('REVIEW_PAGE_V1') === 0);
  if (!sh) throw new Error('The review page tab is missing from this spreadsheet.');
  return sh.getRange(2, 1, sh.getLastRow() - 1, 1).getValues().map(r => String(r[0]).slice(1, -1)).join('');
}

function codeOk_(code) {
  const want = (PropertiesService.getScriptProperties().getProperty('REVIEW_ACCESS_CODE') || '').trim();
  return !want || String(code || '') === want;
}

// Every value is written with a leading apostrophe, which Sheets treats as "this is text" (and hides), so nothing a
// reviewer types becomes a formula, number or date. Reading strips one leading apostrophe if Sheets kept it.
function asText_(v) { return v === '' ? '' : "'" + v; }
function fromCell_(v) { v = String(v); return v.charAt(0) === "'" ? v.slice(1) : v; }

function reviewerKey_(name) { return String(name || '').replace(/\s+/g, ' ').trim().toLowerCase(); }

function sheet_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sh = ss.getSheetByName(SHEET_NAME);
  if (!sh) {
    sh = ss.insertSheet(SHEET_NAME, 0);
    sh.getRange(1, 1, 1, COLS.length).setValues([COLS]).setFontWeight('bold');
    sh.setFrozenRows(1);
  }
  return sh;
}

function getConfig() {
  return {code_required: !!(PropertiesService.getScriptProperties().getProperty('REVIEW_ACCESS_CODE') || '').trim()};
}

function getAnswers(reviewer, code) {
  if (!codeOk_(code)) return {status: 401};
  const key = reviewerKey_(reviewer);
  if (!key) return {status: 400};
  const rows = sheet_().getDataRange().getValues().slice(1);
  const answers = {};
  rows.forEach(r => {
    const rec = Object.fromEntries(COLS.map((c, i) => [c, fromCell_(r[i])]));
    if (rec.reviewer_key !== key) return;
    answers[rec.question_id] = {
      question_decision: rec.question_decision, question_suggestion: rec.question_suggestion,
      reference_decision: rec.reference_decision, reference_edit: rec.reference_edit,
      must_include: rec.must_include ? rec.must_include.split('\n') : [],
      must_not_include: rec.must_not_include ? rec.must_not_include.split('\n') : [],
      comments: rec.comments, reviewed_at: rec.reviewed_at};
  });
  return {status: 200, answers: answers};
}

function clean_(a) {
  if (!a || typeof a !== 'object') throw new Error('bad answer');
  const out = {};
  Object.keys(DECISIONS).forEach(f => {
    const v = a[f] == null ? '' : a[f];
    if (DECISIONS[f].indexOf(v) < 0) throw new Error('bad ' + f);
    out[f] = v;
  });
  Object.keys(LIMITS).forEach(f => {
    const v = a[f] == null ? '' : a[f];
    if (typeof v !== 'string') throw new Error('bad ' + f);
    out[f] = v.slice(0, LIMITS[f]);
  });
  ['must_include', 'must_not_include'].forEach(f => {
    const v = a[f] || [];
    if (!Array.isArray(v) || v.length > MAX_ITEMS || !v.every(x => typeof x === 'string')) throw new Error('bad ' + f);
    out[f] = v.map(x => x.replace(/\s*\n\s*/g, ' ').slice(0, MAX_ITEM_LEN));   // one item per line in the cell
  });
  return out;
}

function saveAnswers(body) {
  body = body || {};
  if (!codeOk_(body.code)) return {status: 401};
  const name = String(body.reviewer || '').trim();
  const key = reviewerKey_(name);
  const answers = body.answers;
  if (!key || name.length > 120 || !answers || typeof answers !== 'object') return {status: 400};
  const ids = Object.keys(answers);
  if (!ids.length || ids.length > QIDS.length || !ids.every(id => QSET.has(id))) return {status: 400};
  let clean;
  try { clean = ids.map(id => [id, clean_(answers[id])]); } catch (e) { return {status: 400}; }
  const now = new Date().toISOString();
  const lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    const sh = sheet_();
    const keys = sh.getLastRow() > 1 ? sh.getRange(2, 1, sh.getLastRow() - 1, COLS.length).getValues() : [];
    const rowOf = {};
    keys.forEach((r, i) => { rowOf[fromCell_(r[COLS.indexOf('reviewer_key')]) + '|' + fromCell_(r[1])] = i + 2; });
    const fresh = [];
    clean.forEach(([id, a]) => {
      const vals = [name, id, a.question_decision, a.reference_decision, a.reference_edit, a.question_suggestion,
        a.must_include.join('\n'), a.must_not_include.join('\n'), a.comments, a.reviewed_at, now, key].map(asText_);
      const row = rowOf[key + '|' + id];
      if (row) sh.getRange(row, 1, 1, COLS.length).setValues([vals]);
      else fresh.push(vals);
    });
    if (fresh.length) sh.getRange(sh.getLastRow() + 1, 1, fresh.length, COLS.length).setValues(fresh);
  } finally {
    lock.releaseLock();
  }
  return {status: 200, saved: clean.length};
}
