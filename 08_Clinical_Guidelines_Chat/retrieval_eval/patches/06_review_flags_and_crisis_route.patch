+_SUICIDE_MENTION = re.compile(r'\bsuicid|\bself[- ]?harm', re.I)
+_NUMBER = re.compile(r'(?<![\w.])\d+(?:[.,]\d+)*(?![\w])')
 
+
+_UNIT_AFTER = re.compile(r'\s*(?:iu|u/|copies|cells|mg|mcg|ml|mmol|g\b|kg|%|units?)', re.I)
+
+
+def _numbers(text, skip_years=False):
+    found = set()
+    for match in _NUMBER.finditer(text or ''):
+        number = match.group(0).replace(',', '')
+        # "the 2025 PrEP guidelines" is a year, not a clinical value ("2000 IU/mL" is).
+        if skip_years and re.fullmatch(r'(?:19|20)\d\d', number) and not _UNIT_AFTER.match(text, match.end()):
+            continue
+        found.add(number.rstrip('0').rstrip('.') if '.' in number else number)
+    return found
+
+
+def review_reasons(question, blocks, sources, ambiguity=''):
+    """What a clinician should check in this answer, most specific first (at most 4)."""
+    claims = [b for b in blocks if b.get('type', 'guideline_claim') == 'guideline_claim']
+    if not claims:
+        return []
+    cited = [sources[n - 1] for b in claims for n in b['citations'] if 1 <= n <= len(sources)]
+    cited_text = ' '.join(' '.join(filter(None, (s.get('heading_path'), s.get('caption'), s.get('text'))))
+                          for s in cited)
+    answer_text = ' '.join(b['text'] for b in claims)
+    reasons = []
+    # Checks on the answer itself.
+    missing = sorted(_numbers(answer_text, skip_years=True) - _numbers(question) - _numbers(cited_text) - {'1', '2', '3'})
+    if missing:
+        reasons.append('the number(s) ' + ', '.join(missing[:4]) + ': not found in the cited passages')
+    if any(s['document']['id'] == '0' for s in cited) and any(
+            s['document']['id'] == '1' and s not in cited for s in sources):
+        reasons.append('whether the 2024 HIV Amendment changed this (the answer cites the 2022 guideline)')
+    if _VERDICT_LEAD.match(claims[0]['text']):
+        reasons.append('that the yes/no follows from the guideline rule it rests on')
+    if ambiguity:
+        reasons.append('that the passages answer this question (the match was weak)')
+    # Checks that follow from the kind of question.
+    if _PATIENT_VALUE.search(question):
+        reasons.append("which band or threshold the patient's value falls in")
+    for group, in_question, in_source in _PATIENT_GROUPS:
+        if re.search(in_question, question, re.I):
+            covered = re.search(in_source, cited_text, re.I)
+            reasons.append(f'that the rule is the one for {group}' + ('' if covered else
+                                                                      ' (the cited passages do not mention it)'))
+            break
+    if _SUICIDE_MENTION.search(question):
+        reasons.append('suicide risk: assess it and follow the risk-level actions')
+    if high_risk_question(question):
+        reasons.append('every step and dose against the passage (emergency or dose question)')
+    elif _TREATMENT_QUESTION.search(question):
+        reasons.append('the drug, dose and schedule against the passage')
+    return reasons[:4]
+
+
+def review_notice(reasons):
+    if not reasons:
+        return CHECK_NOTICE
+    return REVIEW_NOTICE + ': ' + '; '.join(f'({n}) {r}' for n, r in enumerate(reasons, 1)) + '.'
