+def chunk_sources(chunk_ids):
+    """Source records (as search() returns them) for the given chunk ids, in the given order."""
+    db = sqlite3.connect(INDEX)
+    try:
+        rows = {row[0]: row for row in db.execute(
+            'SELECT chunk_id,doc_id,title,heading_path,page_start,page_end,type,text,caption,version '
+            'FROM chunks WHERE chunk_id IN (' + ','.join('?' for _ in chunk_ids) + ')', list(chunk_ids))}
+    finally:
+        db.close()
+    sources = []
+    for chunk_id in chunk_ids:
+        if chunk_id not in rows or rows[chunk_id][1] not in CHUNK_DOCS:
+            continue
+        _, chunk_doc, title, heading, page, page_end, kind, text, caption, version = rows[chunk_id]
+        meta = DOCS_BY_ID[CHUNK_DOCS[chunk_doc]]
+        pdf = meta['filename'].lower().endswith('.pdf')
+        sources.append({'chunk_id': chunk_id, 'document': dict(meta, title=title, version=version),
+                        'page': page, 'page_end': page_end, 'heading_path': heading, 'type': kind,
+                        'text': text, 'caption': caption,
+                        'page_kind': 'PDF page' if pdf else 'Converted page',
+                        'url': '/documents/' + meta['id'] + ('#page=' + str(page) if page and pdf else '')})
+    return sources
+
+
+def crisis_response(question, program, drafts):
+    """Fixed, cited emergency actions for active self-harm intent; falls back to passages only."""
+    wanted = list(dict.fromkeys(i for _, ids in CRISIS_BLOCKS for i in ids))
+    sources = chunk_sources(wanted)
+    number = {s['chunk_id']: n for n, s in enumerate(sources, 1)}
+    blocks = [{'text': text, 'type': 'guideline_claim', 'citations': [number[i] for i in ids if i in number]}
+              for text, ids in CRISIS_BLOCKS]
+    if not all(b['citations'] for b in blocks):
+        # The guideline passages are not in this index: show the best passages without any generated text.
+        found = search('suicide risk: do not leave alone, remove means of self-harm, urgent referral',
+                       program, drafts)
+        return source_only_result(question, found, [CRISIS_NOTICE])
+    references = reference_list(blocks, sources)
+    message = '\n\n'.join(b['text'] for b in blocks) + '\n\nSources: ' + '; '.join(references)
+    print('[Review] crisis route: fixed self-harm reply', flush=True)
+    return {'mode': 'fixed', 'kind': 'answer', 'blocks': blocks, 'references': references, 'message': message,
+            'sources': sources, 'notices': [CRISIS_NOTICE],
+            'review': {'level': 'review', 'reasons': ['suicide or self-harm risk']}}
+
