+    r"|\b(?:take|swallow)\s+(?:them|it|all\s+(?:of\s+)?(?:the|her|his|my|their))\s*(?:all\b|pills|tablets)"
+    r"|\b(?:pills?|tablets?|medicines?)\b[^.?!]{0,60}\b(?:take|swallow)\s+(?:them|all)\b",
