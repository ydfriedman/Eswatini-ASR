+# whether the answer is wrong.
+_VERDICT_LEAD = re.compile(r'^\s*(?:yes|no)\b', re.I)
+_PATIENT_VALUE = re.compile(
+    r'\b\d+(?:\.\d+)?\s*(?:-?\s*(?:year|yr|month|week|day)s?[- ]old|kg|g/dl|mmol/l|mg/dl|copies|cells|%|'
